{
  "info": {
    "name": "Mahaprastanam Operations Suite - AP Govt API",
    "description": "Complete Postman Collection for Mahaprastanam Operations Suite API endpoints (Base URL: https://one.bhspl.in/mp/api)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://one.bhspl.in/mp/api",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "YOUR_BEARER_TOKEN_HERE",
      "type": "string"
    },
    {
      "key": "activeRole",
      "value": "ADMIN",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Auth & Profile",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identity\": \"9502017775\",\n  \"phone\": \"9502017775\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"YOUR_REFRESH_TOKEN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Active-Role", "value": "{{activeRole}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          }
        },
        {
          "name": "Get Current User Me",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Active-Role", "value": "{{activeRole}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "Profile Stats",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Active-Role", "value": "{{activeRole}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/profile-stats?project_id=4",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "profile-stats"],
              "query": [
                { "key": "project_id", "value": "4" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Beneficiaries & Transit",
      "item": [
        {
