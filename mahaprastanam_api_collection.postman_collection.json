              "raw": "{\n  \"vehicle_id\": 12,\n  \"driver_id\": 45,\n  \"start_district\": \"Guntur\",\n  \"destination_district\": \"Tenali\",\n  \"odo_start\": 42180,\n  \"status\": \"SUBMITTED\"\n}"
